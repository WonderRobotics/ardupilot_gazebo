<?xml version='1.0'?>
<sdf version="1.9">
  <model name="vtol">
    <include>
      <name>vtol</name>
      <pose degrees="true">0 0 0 0 0 0</pose>
      <uri>model://alti_transition_quad</uri>
    </include>

    <include>
      <name>camera</name>
      <pose relative_to="vtol" degrees="true">0 0 -0.1 0 0 90</pose>
      <uri>model://fixed_camera</uri>
    </include>

    <joint name='vtol_cam_joint' type='fixed'>
      <parent>vtol::base_link</parent>
      <child>camera::camera_link</child>
      <pose relative_to="vtol">0 0 0 0 0 0</pose>
    </joint>

    <include>
      <name>lidar</name>
      <pose relative_to="vtol" degrees="true">0.2 0 -0.1 0 0 0</pose>
      <uri>model://lidar_down</uri>
    </include>

    <joint name='vtol_lidar_joint' type='fixed'>
      <parent>vtol::base_link</parent>
      <child>lidar::lidar_link</child>
      <pose relative_to="vtol"> 0 0 0 0 0 0</pose>
    </joint>
  </model>
</sdf>
